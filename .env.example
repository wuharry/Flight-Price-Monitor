# local | supabase (cloud deployment requires supabase)
STORAGE=local
DATA_DIR=.data
WATCH_RULES_FILE=watch-rules.json
SUPABASE_URL=https://dejudisyuvkdkshnykog.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# preview does not send or mark alerts as delivered
EMAIL_MODE=preview
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=Flight Monitor <alerts@example.com>
NOTIFICATION_TO_EMAIL=

MONITOR_INTERVAL_MINUTES=180
# chromium (install via pnpm exec playwright install chromium), chrome, msedge
BROWSER_CHANNEL=chromium
# The observed Tigerair edge rejected headless Edge; use a normal browser first.
BROWSER_HEADLESS=false
BROWSER_TIMEOUT_MS=90000
